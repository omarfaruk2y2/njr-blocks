{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/njr-dynamic-slider",
  "version": "0.1.0",
  "title": "NJR Dynamic Slider",
  "category": "widgets",
  "icon": "slides",
  "description": "Dynamic Swiper-based slider block.",
  "attributes": {
    "slides": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        }
      }
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    },
    "effect": {
      "type": "string",
      "default": "slide"
    },
    "speed": {
      "type": "number",
      "default": 500
    },
    "delay": {
      "type": "number",
      "default": 3000
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "textdomain": "njr-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
